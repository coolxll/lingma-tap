# Lingma API Credentials for Testing
# Copy this file to .env and fill in your real values.
# DO NOT COMMIT .env TO GIT.

LINGMA_UID=lingma_user_id
LINGMA_TOKEN=pt-your-token-here
LINGMA_MID=lingma_machine_id

# Required by the headless gateway. Generate with: openssl rand -hex 32
GATEWAY_API_KEY=replace-with-a-long-random-secret
